rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Zero Trust: Acceso denegado por defecto
    match /{document=**} {
      allow read, write: if false;
    }

    // Colección de órdenes de auxilio y rescate
    match /tow_orders/{orderId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.createdBy ||
        request.auth.token.role in ['ADMIN', 'DISPATCHER', 'DRIVER', 'INSURANCE_AUDITOR']
      );
      allow create: if isAuthenticated() && (
        request.resource.data.createdBy == request.auth.uid ||
        request.auth.token.role in ['ADMIN', 'DISPATCHER']
      );
      allow update: if isAuthenticated() && 
        request.resource.data.createdBy == resource.data.createdBy &&
        (request.auth.token.role in ['ADMIN', 'DISPATCHER', 'DRIVER']);
      allow delete: if isAuthenticated() && request.auth.token.role == 'ADMIN';
    }

    // Actas de Remolque y Peritajes de Daños (Inmutables una vez selladas con SHA-256)
    match /tow_actas/{actaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.token.role in ['ADMIN', 'DISPATCHER', 'DRIVER'];
      allow update: if false; // Inmutabilidad forense
      allow delete: if false; // Inmutabilidad forense
    }

    // Flota de Grúas y Móviles
    match /fleet_units/{unitId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.role == 'ADMIN';
    }
  }
}
